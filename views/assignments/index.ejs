<!DOCTYPE html>
<html>
<head>
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>

<main class="container mt-5">

    <h1>My Assignments</h1>

    <p>View and manage all your assignments below.</p>

    <a href="/assignments/add" class="btn btn-primary">Add Assignment</a>

    <hr>

    <% if (assignments.length > 0) { %>

        <table class="table table-bordered">

            <tr>
                <th>Assignment</th>
                <th>Course</th>
                <th>Due Date</th>
                <th>Priority</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>

            <% for (let count = 0; count < assignments.length; count++) { %>

                <tr>
                    <td><%= assignments[count].title %></td>

                    <td><%= assignments[count].course %></td>

                    <td><%= assignments[count].dueDate %></td>

                    <td><%= assignments[count].priority %></td>

                    <td><%= assignments[count].status %></td>

                    <td>
                        <a href="/assignments/edit/<%= assignments[count]._id %>" class="btn btn-warning">
                            Edit
                        </a>

                        <a href="/assignments/delete/<%= assignments[count]._id %>"
                            onclick="return confirm('Are you sure you want to delete this assignment?')">
                                Delete
                        </a>
                    </td>
                </tr>

            <% } %>

        </table>

    <% } else { %>

        <p>You have not added any assignments yet.</p>

    <% } %>

    <hr>

    <a href="/" class="btn btn-secondary">Back to Home</a>

</main>

</body>
</html>
